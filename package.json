{
  "name": "draw-steel-elements",
  "version": "7.0.0",
  "description": "Components to support the Draw Steel TTRPG by MCDM.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "build-no-check": "node esbuild.config.mjs production",
    "harness:build": "node visual-harness/esbuild.mjs",
    "host-css": "node visual-harness/fetch-obsidian-app-css.mjs",
    "gen-light-island": "node visual-harness/obsidian-light-island.mjs",
    "shots": "npm run harness:build && node visual-harness/shoot.mjs",
    "shot-url": "node visual-harness/shoot-url.mjs",
    "obsidian-shots": "node visual-harness/notes-gen.mjs && npm run build-no-check && node visual-harness/obsidian-camera.mjs",
    "obsidian-lifecycle": "npm run build-no-check && node visual-harness/obsidian-lifecycle.mjs",
    "docs-shots": "node visual-harness/notes-gen.mjs && npm run harness:build && npm run build-no-check && node visual-harness/docs-shots.mjs",
    "test": "jest",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "tsc": "tsc --noEmit && tsc --noEmit -p e2e",
    "e2e": "node e2e/run.mjs",
    "lint": "eslint src main.ts",
    "parity:site": "node visual-harness/parity/site-capture.mjs",
    "parity": "npm run harness:build && node visual-harness/parity/plugin-capture.mjs && node visual-harness/parity/diff.mjs"
  },
  "keywords": [],
  "author": "Steel Compendium",
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-keywords": "^5.1.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.23.0",
    "@types/css": "^0.0.38",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "10.0.10",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "builtin-modules": "5.0.0",
    "css": "^3.0.0",
    "esbuild": "0.25.9",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "expect-webdriverio": "6.1.0",
    "fflate": "^0.8.3",
    "gifenc": "1.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.4.1",
    "js-yaml": "^4.1.0",
    "lucide": "^1.24.0",
    "marked": "^18.0.6",
    "obsidian": "1.13.1",
    "playwright": "^1.61.1",
    "pngjs": "7.0.0",
    "steel-compendium-sdk": "3.1.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tslib": "2.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "wdio-obsidian-service": "3.3.0",
    "webdriverio": "9.32.0",
    "yaml": "^2.9.0"
  }
}
