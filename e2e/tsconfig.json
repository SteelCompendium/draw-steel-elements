{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha", "@wdio/globals/types", "expect-webdriverio", "wdio-obsidian-service"]
  },
  "include": ["**/*.ts", "**/*.mts"],
  "exclude": [".out", "node_modules"]
}
